{
  "name": "gigaforge",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "backend"
  ],
  "scripts": {
    "server": "bun backend/main.ts",
    "build": "bun run --cwd backend build",
    "clean": "rm -rf backend/dist",
    "lint": "tsc --noEmit -p backend/tsconfig.json && tsc --noEmit -p tsconfig.json",
    "test": "bun test backend/tests tests/integration",
    "test:backend": "bun test backend/tests"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "typescript": "^7.0.2"
  }
}
