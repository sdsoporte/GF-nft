# Keep the build context small and free of secrets. The image copies only the
# backend entrypoint plus src/domain and src/engine, so anything listed here is
# either unused build context or must never reach an image layer.
.git
.gitignore
node_modules
node_modules/
dist
coverage
odd
docs
public
gf
vite.config.ts
index.html
src/App.tsx
src/main.tsx
src/mcp
src/persistence
src/domain/web3DomainModel.ts
.env
.env.*
*.log
**/*.log
**/*.md
.atl
.DS_Store
