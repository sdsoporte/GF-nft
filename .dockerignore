# Keep the build context small and free of secrets. The image copies only
# backend/package.json, backend/main.ts and backend/src (domain, engine, mcp,
# persistence), so anything listed here is either unused build context or must
# never reach an image layer. The archived web demo (docs/archive/web-demo),
# the tests, the game project and local env files stay out.
.git
.gitignore
node_modules
node_modules/
dist
coverage
odd
docs
public
game
tests
backend/tests
backend/tsconfig.json
.env
.env.*
*.log
**/*.log
**/*.md
.atl
.DS_Store
